CORS_ORIGIN=*

CLIENT_URL=https://localhost:5173

NODE_ENV=development

DB_HOST=localhost
DB_PORT=13306
DB_USERNAME=test_user
DB_PASSWORD=test_user
DB_DATABASE=test_db

REDIS_HOST=localhost
REDIS_PORT=16379
RTB_CAMPAIGN_SOURCE=redis_json
RTB_EMBEDDING_PROFILE=multilingual_e5_small
RTB_EMBEDDING_QUEUE_NAME=
RTB_DENSE_RETRIEVAL_MODE=semantic_document
RTB_MATCHER_DOCUMENT_SIMILARITY_THRESHOLD=0.3
# dense_only | shadow | hybrid(현재 shadow와 동일: primary만 reserve)
RTB_RETRIEVAL_MODE=dense_only
# RTB_HYBRID_RRF_K=60
# RTB_HYBRID_DENSE_WEIGHT=1
# RTB_HYBRID_SPARSE_WEIGHT=0.2
# RTB_HYBRID_SPARSE_SUPPLEMENT_LIMIT=10
# RTB_HYBRID_FINAL_LIMIT=10

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=your_redirect_uri

JWT_SECRET=your_jwt_secret

NCP_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
NCP_SECRET_KEY=YOUR_SECRET_KEY_HERE
NCP_REGION=kr-standard
NCP_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_BUCKET=boostadad-campaign-images

TOSS_SECRET_KEY=test_sk_여기에_발급받은_시크릿키
